# Your shared BoardGameGeek account (the one your collection & plays are tracked under)
BGG_USERNAME=PhilFox

# --- BGG access ---
# BGG sits behind Cloudflare, which fingerprints the TLS handshake and runs a JS challenge.
# No Node HTTP client can pass that, so syncing drives a real Chromium bundled in the image.
# This needs no configuration and no cookie -- the settings below are escape hatches only.
#
#   auto    (default) plain HTTP first, switch to the browser when BGG demands credentials
#   browser always use the bundled browser
#   http    never use the browser (needs BGG_COOKIE, and usually fails behind Cloudflare)
BGG_FETCH_MODE=auto

# Everything below is optional and only used by BGG_FETCH_MODE=http.
#
# BGG's XML API answers unauthenticated requests with
#   401  WWW-Authenticate: Bearer realm="xml api"
# Note that a cookie copied from your browser usually still fails, because Cloudflare binds
# cf_clearance to the TLS fingerprint of the client that earned it, which Node cannot reproduce.
#
# To get BGG_COOKIE:
#   1. Open https://boardgamegeek.com in your browser (log in).
#   2. F12 -> Network tab -> reload the page.
#   3. Click the first request to boardgamegeek.com -> Request Headers -> "cookie".
#      (Request Headers, not Response Headers, and not document.cookie in the console --
#       that one silently omits HttpOnly cookies such as cf_clearance.)
#   4. Copy the ENTIRE value and paste it below on ONE line, no quotes.
#      If the value contains a literal $, double it to $$ or compose will try to expand it.
#
# This is an account credential: treat .env as a secret and never commit it.
# It expires eventually; if syncs start failing with a 401, copy a fresh one.
BGG_COOKIE=

# REQUIRED whenever BGG_COOKIE contains cf_clearance. Cloudflare binds that cookie to the exact
# browser that obtained it, so this must be the User-Agent of the browser you copied it from.
# Get it by running   navigator.userAgent   in that browser's console.
BGG_USER_AGENT=

# Alternative, if BGG has issued you an API bearer token. Leave blank if unused.
BGG_TOKEN=

# The two of you - these are app login credentials, not your BGG account.
USER1_USERNAME=phil
USER1_PASSWORD=change-me
USER1_DISPLAY_NAME=Phil

USER2_USERNAME=partner
USER2_PASSWORD=change-me-too
USER2_DISPLAY_NAME=Partner

# Port exposed on your machine (http://localhost:HOST_PORT)
HOST_PORT=8080
