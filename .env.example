# Your shared BoardGameGeek account (the one your collection & plays are tracked under)
BGG_USERNAME=PhilFox

# --- BGG access ---
# BGG's XML API requires a registered application token on nearly every endpoint. The one
# exemption is downloading your OWN collection while logged in to the site in a browser, which is
# why a collection URL works there but /thing returns:
#   401  WWW-Authenticate: Bearer realm="xml api"
#
# Register an application at https://boardgamegeek.com/applications, then click "Tokens" next to
# it to create one. Paste just the token; Sweeple adds the "Bearer " prefix itself.
# Keep this secret: .env is gitignored, and a leaked token can have its access revoked.
BGG_TOKEN=

# How the server talks to BGG.
#   auto    (default) plain HTTPS; falls back to the bundled browser only when NO token is set
#   browser always use the bundled Chromium
#   http    plain HTTPS only
# With BGG_TOKEN set, plain HTTPS is all you need.
BGG_FETCH_MODE=auto

# Legacy escape hatches, only used by BGG_FETCH_MODE=http without a token. Copying a browser
# cookie generally does NOT work: Cloudflare binds cf_clearance to the client that earned it.
BGG_COOKIE=
BGG_USER_AGENT=

# --- German card texts (optional) ---
# Each card shows BGG's short description, which is English. With a Nano-GPT key set, Sweeple
# translates them into German once and keeps the result; without one the English shows.
# Any text can also be written in German by hand in Settings.
# Key: https://nano-gpt.com/api — keep it secret like BGG_TOKEN.
NANOGPT_API_KEY=
# The model is picked in Settings, from Nano-GPT's list. This is only the starting choice until
# one is picked there. Choose one your subscription covers, or translations go on your balance.
NANOGPT_MODEL=
# Only change if Nano-GPT's API moves. OpenAI-compatible chat completions are expected here.
# NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Port exposed on your machine (http://localhost:HOST_PORT)
HOST_PORT=8080
