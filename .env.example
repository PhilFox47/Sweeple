# Your shared BoardGameGeek account (the one your collection & plays are tracked under)
BGG_USERNAME=PhilFox

# BGG's XML API answers unauthenticated requests with
#   401  WWW-Authenticate: Bearer realm="xml api"
# Your browser gets through on cookies it already holds; a server has none, so supply one.
#
# To get BGG_COOKIE:
#   1. Open https://boardgamegeek.com in your browser (log in).
#   2. F12 -> Network tab -> reload the page.
#   3. Click the first request to boardgamegeek.com -> Request Headers -> "cookie".
#   4. Copy the ENTIRE value and paste it below on one line.
# It expires eventually; if syncs start failing with a 401, copy a fresh one.
BGG_COOKIE=

# Alternative, if BGG has issued you an API bearer token. Leave blank if unused.
BGG_TOKEN=

# The two of you - these are app login credentials, not your BGG account.
USER1_USERNAME=phil
USER1_PASSWORD=change-me
USER1_DISPLAY_NAME=Phil

USER2_USERNAME=partner
USER2_PASSWORD=change-me-too
USER2_DISPLAY_NAME=Partner

# Port exposed on your machine (http://localhost:HOST_PORT)
HOST_PORT=8080
